{
  "name": "postcss-merge-at-rules",
  "version": "2.0.0",
  "description": "PostCSS plugin for merging and nesting CSS at rules",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "css",
    "css-optimizations",
    "at-rules",
    "responsive-css",
    "merge-at-rules"
  ],
  "author": "Victor Saa <vis97c@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vis97c/postcss-merge-at-rules.git"
  },
  "bugs": {
    "url": "https://github.com/vis97c/postcss-merge-at-rules/issues"
  },
  "homepage": "https://github.com/vis97c/postcss-merge-at-rules",
  "main": "index.js",
  "scripts": {
    "lint": "eslint --ext .js --ignore-path .prettierignore .",
    "test:update": "gulp",
    "test": "yarn lint && jest-ci --coverage",
    "refresh-deps": "rm -rf node_modules && rm yarn.lock && yarn",
    "release": "yarn semantic-release",
    "release:dry": "yarn semantic-release --dry-run",
    "prepare": "node .husky/install.mjs"
  },
  "packageManager": "yarn@1.22.21",
  "engines": {
    "node": ">=20.19.3",
    "yarn": ">=1.22.4"
  },
  "dependencies": {
    "sort-css-media-queries": "2.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@open-xamu-co/eslint-config": "^3.0.1",
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/git": "^9.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^25.3.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prettier": "^5.0.0",
    "gulp": "^5.0.0",
    "gulp-postcss": "9.0.1",
    "gulp-rename": "^2.0.0",
    "husky": "^9.1.7",
    "jest": "^27.3.1",
    "jest-ci": "^0.1.1",
    "jest-cli": "^27.3.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.2.10",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4",
    "semantic-release": "^17.1.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "postcss": "^8.4.38"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 99
      }
    }
  }
}
